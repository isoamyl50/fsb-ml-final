# Raw & processed datasets (keep .gitkeep markers tracked)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.zip

# Python & Jupyter
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/
.jupyter/
.jupyter_ystore.db

# Model binaries & large serialized artifacts
artifacts/**/*.pt
artifacts/**/*.pth
artifacts/**/*.ckpt
artifacts/**/*.pkl
artifacts/**/*.joblib
artifacts/**/*.npz
artifacts/**/*.parquet

# Approach-local outputs (shared JSON reports remain in experiments/runs/)
/artifacts/approach_1_linear_sgd/

# Interrupted atomic writes; never ignore shared run JSONs or YAML configs
/artifacts/**/*.tmp
/artifacts/**/*.tmp.*
/experiments/**/*.tmp
/experiments/**/*.tmp.*

# Generated flat CSV leaderboard (rebuild from experiments/runs/*.json)
experiments/leaderboard.csv
experiments/.locks/
experiments/leaderboard.lock

# Slidev generated outputs
slides/node_modules/
slides/dist/
slides/.slidev/
slides/exports/*.pdf
*.pdf

# OS & editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
