  "challenges": [
    {
      "problem": "Tỉ lệ thiếu dữ liệu cao (Frontage 38%, Access Road 44%, Direction 70-83%)",
      "solution": "Không dùng dropna() (chỉ còn 8.75%); dùng Train-only median imputation + cờ báo thiếu"
    },
    {
      "problem": "Nhiễu Unicode NFD/NFC & tin đăng trùng lặp của môi giới (1,708 cụm)",
      "solution": "Chuẩn hóa Unicode NFC, map tên tỉnh thành chuẩn và dùng Group-Stratified Split"
    }
  ],
  "course_reflections": [
    {
      "concept": "Bias – Variance Trade-off & Regularization",
      "application": "Linear SGD bị high bias (Val RMSE 1.2816); thêm 1 tầng ẩn 128 ReLU giảm bias rõ rệt, trong khi 2 tầng (128,64)+BN sớm overfit (ep 9–10). Dropout 0.1 + L2 1e-4 + Early Stopping giữ ổn định giữa 3 seeds (1.2079 ± 0.0032)."
    },
    {
      "concept": "Data Leakage & Kỷ luật Pipeline",
      "application": "StratifiedGroupKFold trên 1,708 cụm tin đăng lặp (4,189 tin), imputer/scaler fit riêng trên Train và 5-fold OOF Target Encoding + TF-IDF giúp Feature Engineering P0→P4 giảm 34.6–35.7% RMSE mà không rò rỉ Test."
    }
  ],
  "conclusions": {
    "recommended_model": "MLP (1 tầng ẩn 128 ReLU, Adam, Dropout=0.1, P4_geo_priors)",
    "key_takeaways": [
      "Feature Engineering (P0→P4) đóng góp mức giảm sai số áp đảo (~0.64–0.71 tỷ RMSE, ~35%), vượt xa tinh chỉnh siêu tham số thuần túy.",
      "Trong nhóm mô hình gradient-based môn học, MLP + Adam đạt Test RMSE = 1.2300 tỷ, R² = 0.6896, vượt trội Linear SGD (1.2936 tỷ) và thu hẹp khoảng cách còn 0.0345 tỷ so với HGB tham chiếu (1.1955 tỷ)."
    ],
    "future_work": [
      "Bổ sung tọa độ bản đồ (lat/lon) và PhoBERT embedding trên Address/mô tả chi tiết để giảm sai số ở phân khúc nhà ≥ 7 tỷ.",
      "Dự đoán khoảng tin cậy giá (Quantile Regression / Conformal Prediction) thay vì chỉ một điểm dự đoán."
    ]
  },
